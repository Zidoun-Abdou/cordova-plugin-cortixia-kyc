<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cortixia KYC — Cordova plugin.

  Brings the Cortixia identity-verification flow (MRZ scan → NFC chip read →
  liveness) to Cordova apps, including OutSystems O11 Reactive, which imports
  standard Cordova plugins. The plugin owns the guided scanning screens
  natively (same UX as the Flutter SDK) and returns a single result object.

  The chip cannot be read from JavaScript — the native layer does the eMRTD
  BAC/secure-messaging read (jMRTD on Android, NFCPassportReader on iOS) and
  posts the raw datagroups to the Cortixia server for decoding.
-->
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-cortixia-kyc"
        version="0.1.3">

    <name>Cortixia KYC</name>
    <description>Algerian eKYC: MRZ, NFC chip read and liveness, with guided native screens.</description>
    <license>Proprietary</license>
    <keywords>cortixia,kyc,nfc,mrz,liveness,emrtd,outsystems</keywords>

    <engines>
        <engine name="cordova" version=">=11.0.0" />
    </engines>

    <!-- JS interface exposed to the Cordova/OutSystems app -->
    <js-module src="www/cortixiaKyc.js" name="CortixiaKyc">
        <clobbers target="cordova.plugins.cortixiaKyc" />
    </js-module>

    <!-- ============================ Android ============================ -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CortixiaKyc">
                <param name="android-package" value="dz.cortixia.kyc.CortixiaKycPlugin" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.CAMERA" />
            <uses-permission android:name="android.permission.NFC" />
            <uses-feature android:name="android.hardware.nfc" android:required="false" />
        </config-file>

        <!-- Guided scanning screens. AppCompat theme (no custom style resource). -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <activity android:name="dz.cortixia.kyc.MrzScanActivity"
                      android:theme="@style/Theme.AppCompat.NoActionBar"
                      android:screenOrientation="portrait"
                      android:exported="false" />
            <activity android:name="dz.cortixia.kyc.LivenessActivity"
                      android:theme="@style/Theme.AppCompat.NoActionBar"
                      android:screenOrientation="portrait"
                      android:exported="false" />
            <activity android:name="dz.cortixia.kyc.NfcReadActivity"
                      android:theme="@style/Theme.AppCompat.NoActionBar"
                      android:screenOrientation="portrait"
                      android:exported="false" />
        </config-file>

        <source-file src="src/android/CortixiaKycPlugin.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />
        <source-file src="src/android/CortixiaApi.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />
        <source-file src="src/android/MrzDetector.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />
        <source-file src="src/android/MrzScanActivity.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />
        <source-file src="src/android/LivenessActivity.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />
        <source-file src="src/android/NfcReadActivity.java"
                     target-dir="app/src/main/java/dz/cortixia/kyc" />

        <!-- ProGuard/R8 rules the plugin needs — shipped with the plugin and
             wired in by the framework gradle so minified client builds work
             without any manual keep rules. -->
        <!-- cordova-android resolves resource-file targets under app/src/main/. -->
        <resource-file src="src/android/cortixia-kyc-proguard.pro"
                       target="cortixia-kyc-proguard.pro" />

        <!-- minSdk 26 (NFC + the eMRTD stack). Applied via the framework gradle below. -->
        <framework src="src/android/cortixia-kyc.gradle" custom="true" type="gradleReference" />
    </platform>

    <!-- ============================== iOS ============================== -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="CortixiaKyc">
                <param name="ios-package" value="CortixiaKycPlugin" />
            </feature>
        </config-file>

        <config-file target="*-Info.plist" parent="NSCameraUsageDescription">
            <string>La caméra est utilisée pour scanner votre document et vérifier votre identité.</string>
        </config-file>
        <config-file target="*-Info.plist" parent="NFCReaderUsageDescription">
            <string>Le lecteur NFC lit la puce de votre document d'identité.</string>
        </config-file>
        <!-- eMRTD applet the ISO7816 reader session may SELECT (ICAO 9303). -->
        <config-file target="*-Info.plist" parent="com.apple.developer.nfc.readersession.iso7816.select-identifiers">
            <array>
                <string>A0000002471001</string>
            </array>
        </config-file>

        <!-- NFC Tag Reading entitlement (requires a PAID team with the
             capability enabled on the App ID — see docs/INTEGRATION.md).
             cordova-ios 7+ keeps these under the fixed "App" project dir; the
             bare filename resolves to the wrong path and is silently ignored. -->
        <config-file target="App/Entitlements-Debug.plist" parent="com.apple.developer.nfc.readersession.formats">
            <array><string>TAG</string></array>
        </config-file>
        <config-file target="App/Entitlements-Release.plist" parent="com.apple.developer.nfc.readersession.formats">
            <array><string>TAG</string></array>
        </config-file>

        <source-file src="src/ios/CortixiaKycPlugin.swift" />
        <source-file src="src/ios/CortixiaApi.swift" />
        <source-file src="src/ios/MrzParser.swift" />
        <source-file src="src/ios/MrzScanViewController.swift" />
        <source-file src="src/ios/LivenessViewController.swift" />
        <source-file src="src/ios/EMRTDReader.swift" />

        <framework src="CoreNFC.framework" />
    </platform>
</plugin>
